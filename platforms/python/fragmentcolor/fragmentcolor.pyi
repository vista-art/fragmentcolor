class WindowTarget:
    """
    `RenderCanvasTarget` is a Python-specific wrapper around [WindowTarget](https://fragmentcolor.org/api/targets/windowtarget).

    It adapts [FragmentColor](https://fragmentcolor.org) to work with the RenderCanvas Python project, forwarding all rendering to an internal [WindowTarget](https://fragmentcolor.org/api/targets/windowtarget). See [WindowTarget](https://fragmentcolor.org/api/targets/windowtarget) for the full [Target](https://fragmentcolor.org/api/targets/target) behavior and semantics.

    - Canonical object: [WindowTarget](https://fragmentcolor.org/api/targets/windowtarget)
    - [Target](https://fragmentcolor.org/api/targets/target) trait docs: [Target](https://fragmentcolor.org/api/targets/target)
    """
    def size(self) -> Size:
        """
        Returns the size of the [WindowTarget](https://fragmentcolor.org/api/targets/windowtarget) in pixels.
        `depth` is absent for a window target in every language: `None` in Rust and
        Python, `undefined` in JS, `nil` in Swift and `null` in Kotlin.

        Example:

        ```python
        from fragmentcolor import Renderer
        import os, sys
        # Skip this example in headless/CI environments that have no display surface.
        if os.environ.get('DISPLAY') is None and sys.platform != 'win32' and os.environ.get('FC_ALLOW_WINDOW') != '1':
            raise SystemExit(0)
        from rendercanvas.auto import RenderCanvas
        canvas = RenderCanvas(size=(800, 600))

        renderer = Renderer()
        target = renderer.create_target(canvas)
        size = target.size()
        ```
        """
    def resize(self, size: _PySize) -> None:
        """
        Resizes the [WindowTarget](https://fragmentcolor.org/api/targets/windowtarget) to the given width and height.
        Call it when the window or canvas changes size.

        A width or height of zero, such as the 0×0 a minimized window reports, is no error: the target keeps
        its last size and draws at the new one once the window has an area again. A side past the device limit
        returns an error.

        Example:

        ```python
