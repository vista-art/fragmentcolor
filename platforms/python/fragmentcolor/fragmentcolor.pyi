    def load(self, renderable: _Renderable) -> None:
        """
        Realize every pending GPU upload referenced by a renderable. Material's
        texture setters (`base_color_texture`, `metallic_roughness_texture`, …)
        accept paths, bytes, and URLs in addition to
        already-uploaded [`Texture`](https://fragmentcolor.org/api/texture/texture)
        handles; the path / bytes / URL variants are stored on the Material's
        Shader as *pending* uploads. `load` walks every Shader the renderable
        visits, drains its pending list, calls
        [`Renderer::create_texture`](https://fragmentcolor.org/api/core/renderer#create_texture)
        for each, and writes the resulting `Texture` into the matching uniform.

        An upload that fails stays pending and the others still bind, so a good
        normal map binds even when the base color path is missing. `load` returns
        the first failure, and so does every later `load`, and every native
        `render`, until the input is fixed or replaced. A map the shader doesn't
        declare fails the `load` that uploads it, once, and the other maps still
        bind. The latest setter call for a map wins, even one made while `load` is
        uploading the older input, which is then dropped.

        On native targets, [`Renderer::render`](https://fragmentcolor.org/api/core/renderer)
        runs `load` first whenever the renderable has pending uploads, so an
        explicit `load` is optional there. Reach for it when you want to pay the
        decode and upload cost outside the render loop, for example in a loading
        screen that prepares the scene before the first frame goes out.

        On the web, `render` can't wait for an upload, so it leaves pending uploads
        alone. Await `load` before the first `render`. Until then, a PBR Material
        draws with its 1×1 default maps.

        In JavaScript, `load` first waits for the frames rendered before it to
        report their GPU errors, and throws the first one, as
        [`Renderer::render`](https://fragmentcolor.org/api/core/renderer#render) describes.

        Example:

        ```python
        from fragmentcolor import Material, Mesh, Model, Renderer, Scene, Vertex
        image = open("examples/assets/logo.png", "rb").read()

        renderer = Renderer()
        target = renderer.create_texture_target([64, 64])

        mesh = Mesh()
        mesh.add_vertices([
            Vertex.pbr([0.0, 0.5, 0.0]).set(Vertex.UV0, [0.5, 1.0]),
            Vertex.pbr([-0.5, -0.5, 0.0]).set(Vertex.UV0, [0.0, 0.0]),
            Vertex.pbr([0.5, -0.5, 0.0]).set(Vertex.UV0, [1.0, 0.0]),
        ])

        # The material keeps the encoded image as a pending upload.
        material = Material.pbr().base_color_texture(image)
        model = Model(mesh, material)
        scene = Scene()
        scene.add(model)

        # Decode and upload it now, so the first render only draws.
        renderer.load(scene)
        renderer.render(scene, target)
        ```
        """
    def read_storage(self, shader: Shader, binding: str) -> bytes:
        """
        Round-trip the GPU-side bytes of a [`Shader`](https://fragmentcolor.org/api/core/shader)'s
        storage binding back to the CPU. Submits any pending uploads, copies the
        storage buffer into a pooled readback staging buffer, maps it, and returns
        the bytes.

        This is the only way to observe what a compute pass *wrote* into a storage
        binding. [`Shader::get`](https://fragmentcolor.org/api/core/shader) returns
        what was last set on the CPU side, so GPU writes don't show up through it.

        `read_storage` is `async` because the underlying `map_async` requires an
        awaited callback. It returns a Promise in JS, is `async` in Swift and
        `suspend` in Kotlin, and blocks until the bytes arrive in Python. On native
        the implementation drives the device forward (`device.poll(Wait)`) before
        awaiting, so callers don't have to spin their own poll loop. On Web the
        browser schedules the callback; the helper just awaits.

        Returns `RendererError::StorageBindingNotFound` when the shader does not
        declare a storage binding called `binding`, or when no render pass has yet
        materialized the GPU-side buffer (storage buffers are allocated lazily on
        first bind).

        In JavaScript, `readStorage` waits for the frames rendered before it to
        report their GPU errors and throws the first one, as
        [`Renderer::render`](https://fragmentcolor.org/api/core/renderer#render)
        describes. An error throws only once, so when another call, such as the next
        `render`, has already thrown it, `readStorage` returns the bytes the failed
        frame left behind.

        Example:

        ```python
        from fragmentcolor import Pass, Renderer, Shader

        renderer = Renderer()
        target = renderer.create_texture_target([16, 16])

        compute = Shader(\"\"\"
            struct Out { values: array<f32, 4> };
            @group(0) @binding(0) var<storage, read_write> out: Out;
            @compute @workgroup_size(1) fn main() {
                out.values[0] = 1.0;
                out.values[1] = 2.0;
                out.values[2] = 3.0;
                out.values[3] = 4.0;
            }

        \"\"\")

        rpass = Pass.compute("seed")
        rpass.set_compute_dispatch(1, 1, 1)
        rpass.add_shader(compute)
        renderer.render(rpass, target)

        bytes = renderer.read_storage(compute, "out")
        ```
        """
    def render(self, renderable: _Renderable, target: TextureTarget | WindowTarget) -> None:
        """
        Renders the given object to the given [Target](https://fragmentcolor.org/api/targets/target).

        `renderable` can be a `Shader`, a `Pass`, a `Mesh`, a `Scene`, or any iterable of `Pass` (`Vec<Pass>`, `&[Pass]`, `&[&Pass]`). Passes in an iterable are rendered in order.

        A window that is hidden or minimized has no frame to draw on. `render` then returns `RendererError::SurfaceError(SurfaceError::Occluded)`, which Python raises as `OccludedSurfaceError`, a `FragmentColorError`. Skip that frame and draw the next one.

        A shader that reads `@location` vertex inputs needs a mesh. Without one, `render` returns `ShaderError::InvalidKey` naming the input. The inputs are the `@location` arguments of the vertex entry point and the `@location` members of its struct arguments, and each one reads the mesh attribute of its own name.

        Each mesh a shader draws is checked against the device, and a mesh past one of its limits returns `RendererError::LimitError`, as a shader does: an input at a location past `max_vertex_attributes`, a vertex or instance stride past `max_vertex_buffer_array_stride`, and mesh data that needs a buffer past `max_buffer_size`. Its `item` names the input, the stride or the buffer. WebGL2 takes strides up to 255 bytes. A mesh draws with every `Renderer` that renders it, each from buffers of its own.

        Before it takes a frame, `render` checks each shader against the device and each texture uniform against its slot, so every language returns these errors from the call that caused them, the web included. A group, binding, binding count, buffer size or workgroup past the device's limits returns `RendererError::LimitError`, a feature the device lacks `RendererError::FeatureError`, a texture uniform that was never set or whose texture its slot can't take `RendererError::BindingError`, and a render shader without its vertex or fragment entry point `RendererError::EntryError`, each with its fields. An unset PBR map slot binds its 1x1 default instead, when the slot takes a 2D float texture. A texture `unregister_texture` removed, or one from another `Renderer`, returns `RendererError::TextureNotFoundError`, in a PBR map slot too. The [Shader](https://fragmentcolor.org/api/core/shader) page lists the checks and each language's form of these errors.

        A `Renderer` draws only into the targets it created. A target from another `Renderer` returns `RendererError::ForeignTarget`, unless every pass is a compute pass, which draws into no target, and a pass target or texture uniform from another `Renderer` returns `RendererError::TextureNotFoundError`. A texture uniform whose `Material` map was set again from a path or bytes is the exception on native, where `render` uploads the new map first and draws it. These come before `render` uploads a queued `Material` map or opens a device, so a refused render changes nothing. A `Renderer` that has opened no device yet returns `RendererError::NoContext` for a target without an owner. Each pass is checked against what it draws into before it records: a [depth target](https://fragmentcolor.org/api/core/pass#set_depth_target) of the color attachment's size and sample count, shader outputs and blending the [target](https://fragmentcolor.org/api/core/pass#set_target)'s format takes, a [viewport](https://fragmentcolor.org/api/core/pass#set_viewport) and a [compute dispatch](https://fragmentcolor.org/api/core/pass#set_compute_dispatch) the device takes, and textures that one pass doesn't both write and read. A render pass can't bind a texture it draws into, and no pass can read a texture one of its bindings writes, so a compute dispatch that samples a texture and stores into it returns `PassError::TextureConflict` too.

        `render` also returns what the GPU rejects. When a pipeline fails to build or a frame's commands fail, it returns a [DeviceError](https://fragmentcolor.org/api/core/deviceerror), `RendererError::DeviceError` in Rust. Its `kind` tells validation errors, internal errors such as a shader the backend compiler refuses, and running out of memory apart, and its `label` names the step that failed: the render pipeline, the compute pipeline, the light binning pipeline, the frame, or a bind group or texture view inside the frame. When one error causes another, `render` returns the first. In Rust, Python, Swift and Kotlin, a pipeline that failed is never kept, and the next frame builds it again and returns the same error.

        A frame that fails is still presented. wgpu clears an image that no valid command drew into, so after a GPU error the window usually shows a cleared frame. On Apple GPUs the renderer submits the commands recorded so far before each compute pass that follows another compute pass. When a pass after that point fails, what the earlier passes drew stays on the image. A shader without its mesh, an instance count past the mesh's instances, a mesh the device's limits or its own checks refuse, a shader or texture the device checks refuse, a target from another `Renderer`, a pass target that is missing, a viewport past the device's 2D limit, and a pass whose own target or compute dispatch fails its checks fail before `render` takes a frame, and the window keeps its last image.

        JavaScript gets the GPU's errors late, because WebGPU reports them after `render` has returned. Each error logs a `console.error` when it lands, and the next `render` still throws the first one, as an `Error` with `kind`, `label` and `detail` properties, before doing any work. `load`, `readTexture`, `readStorage`, and `getImage` on a `Texture` or `TextureTarget` wait for the frames before them to report, so they throw a frame's error even when called right after it. A call that waits throws only the error of a frame rendered before it began: the error of a frame rendered while it waits, even one rendered in the same task right after the call, stays for the next call. Only the first error to land throws, and only once; the ones that land after it, before a call takes it, only log. The label names the render pipeline, the compute pipeline, the light binning pipeline or the frame. A pipeline that failed stays in the cache until its error lands, and a frame that draws with it before then reports a frame error. Once the error lands, the pipeline leaves the cache. In a loop that renders each frame, the next `render` throws the error before doing any work, and the one after it builds the pipeline again and reports the same error.

        Example:

        ```python
        from fragmentcolor import Renderer, Shader

        renderer = Renderer()
        target = renderer.create_texture_target([10, 10])
        shader = Shader.default()

        renderer.render(shader, target)
        ```
        """
    def create_depth_texture(self, size: _PySize) -> Texture:
        """
        Create a depth texture using `Depth32Float`.

        A pass that draws models gets a depth buffer without one. Create a depth texture to read depth in a later pass, or to give depth to a pass of plain meshes.

        A width or height of zero, a side past the device limit, or a depth other than 1 is an error, the one `resize` returns: `TextureError::InvalidInput` inside `InitializationError::TextureError` in Rust.

        The created depth texture inherits the renderer's current sample count:
        - If you called `create_target(window)` (surface-backed), it matches the negotiated MSAA (e.g., 2×/4×) for that surface.
        - If you are rendering offscreen via `create_texture_target`, it defaults to 1.

        This ensures the depth attachment `sample_count` matches the pass sample count.
        A depth texture with a different `sample_count` than the pass makes `render` return
        `RendererError::DepthSampleCountMismatch`, and one whose width or height differs from
        the pass's color attachment returns `RendererError::DepthSizeMismatch`, before it takes
        a frame. A window that resizes needs a depth texture of the new size, or a `resize` of this one.

        Example:

        ```python
        from fragmentcolor import Renderer
        r = Renderer()
        depth = r.create_depth_texture([800, 600])
        ```
        """
    def create_storage_texture(self, size: _PySize, format: TextureFormat, data: bytes | Sequence[SupportsIndex] | npt.NDArray[numpy.integer[Any]] | None = ..., usage: SupportsIndex | TextureUsage | None = ..., usage_bits: SupportsIndex | None = ...) -> Texture:
        """
        Create a storage-class texture for compute shaders, image store/load, or as a render target.

        Common forms:

        - `(size, format)`: empty storage texture, no initial data.
        - `(size, format, bytes)`: storage texture pre-seeded with `bytes`, exactly the size's pixel count times the format's bytes per pixel.
