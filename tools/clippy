#!/usr/bin/env bash
# fc: Format, then run clippy across the workspace (fix to autofix)
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Allows "fix" or "--fix"
FLAG=""
for arg in "$@"; do
	case "$arg" in
		fix|--fix)
			FLAG="--allow-dirty --allow-staged --fix"
			;;
	esac
done

cargo fmt --all
cargo clippy --all --workspace --all-features --all-targets $FLAG
