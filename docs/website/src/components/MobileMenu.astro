---
import { Icon } from "@astrojs/starlight/components";
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";

// The footer renders the configured SocialIcons and ThemeSelect.
// Their Docs and Blog links show from 50rem up, so this list carries them.
const links = [
  { label: "Docs", href: "/welcome/" },
  { label: "Blog", href: "/blog/" },
];
---

<mobile-menu class="md:sl-hidden print:hidden">
  <button
    aria-expanded="false"
    aria-label={Astro.locals.t("menuButton.accessibleLabel")}
    aria-controls="mobile-menu-panel"
    class="sl-flex"
  >
    <Icon name="bars" class="open-menu" />
    <Icon name="close" class="close-menu" />
  </button>
  <nav
    id="mobile-menu-panel"
    class="panel"
    aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
    hidden
  >
    <ul class="links">
      {links.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
    <MobileMenuFooter />
  </nav>
</mobile-menu>

<script>
  class MobileMenu extends HTMLElement {
    button = this.querySelector("button");
    panel = this.querySelector("nav");

    constructor() {
      super();
      this.button?.addEventListener("click", () => this.toggleExpanded());
      this.panel?.addEventListener("click", (event) => this.closeOnLink(event));
      document.addEventListener("click", (event) => this.closeOnClickOutside(event));
      document.addEventListener("keydown", (event) => this.closeOnEscape(event));
      matchMedia("(min-width: 50em)").addEventListener("change", () => this.setExpanded(false));
    }

    get expanded() {
      return this.button?.getAttribute("aria-expanded") === "true";
    }

    setExpanded(expanded: boolean) {
      this.button?.setAttribute("aria-expanded", String(expanded));
      if (this.panel) this.panel.hidden = !expanded;
      document.body.toggleAttribute("data-mobile-menu-expanded", expanded);
      // Keyboard focus stays inside the header and the menu while it is open, as with Starlight's.
      document.querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link").forEach((element) => {
        element.toggleAttribute("inert", expanded);
      });
    }

    toggleExpanded() {
      this.setExpanded(!this.expanded);
    }

    closeOnLink(event: MouseEvent) {
      if (event.target instanceof Element && event.target.closest("a")) this.setExpanded(false);
    }

    closeOnClickOutside(event: MouseEvent) {
      if (!this.expanded) return;
      if (event.target instanceof Node && this.contains(event.target)) return;
      this.setExpanded(false);
    }

    closeOnEscape(event: KeyboardEvent) {
      if (event.key !== "Escape" || !this.expanded) return;
      // The search dialog handles its own Escape.
      if (event.target instanceof Element && event.target.closest("dialog")) return;
      this.setExpanded(false);
      this.button?.focus();
    }
  }

  customElements.define("mobile-menu", MobileMenu);
</script>

<style>
  /* The header keeps room for the button, as it does on pages with a sidebar. */
  :global(header):has(> mobile-menu) {
    padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
  }

  /* Starlight's menu button, with colors that follow the page's color scheme. */
  button {
    position: fixed;
    top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    border: 0;
    border-radius: 50%;
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    padding: 0.5rem;
    background-color: light-dark(var(--sl-color-black), var(--sl-color-white));
    color: light-dark(var(--sl-color-white), var(--sl-color-black));
    box-shadow: var(--sl-shadow-md);
    cursor: pointer;
  }

  button[aria-expanded="true"] {
    background-color: light-dark(var(--sl-color-gray-5), var(--sl-color-gray-2));
    box-shadow: none;
  }

  button[aria-expanded="true"] .open-menu,
  button:not([aria-expanded="true"]) .close-menu {
    display: none;
  }

  .panel {
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block-start: var(--sl-nav-height);
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: calc(100dvh - var(--sl-nav-height));
    overflow-y: auto;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    background-color: var(--sl-color-black);
    box-shadow: var(--sl-shadow-lg);
  }

  .panel[hidden] {
    display: none;
  }

  .links {
    list-style: none;
    padding: 0;
  }

  .links li + li {
    margin-top: 0.75rem;
  }

  .links a {
    display: block;
    border-radius: 0.25rem;
    padding: 0.3em 0.5rem;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: 1.4;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  @media (min-width: 50rem) {
    :global(header):has(> mobile-menu) {
      padding-inline-end: var(--sl-nav-pad-x);
    }
  }
</style>

<style is:global>
  /* Every page loads this, so it matches Starlight's own rule on pages with a sidebar. */
  [data-mobile-menu-expanded] {
    overflow: hidden;
  }

  @media (min-width: 50rem) {
    [data-mobile-menu-expanded] {
      overflow: auto;
    }
  }
</style>
