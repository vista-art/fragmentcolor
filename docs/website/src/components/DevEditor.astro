---
// In dev, edits any Markdown page on disk through /api/dev/edit.
// On the deployed site, edits blog posts through /api/edit, which
// commits them to GitHub. There the button stays hidden without a token.
const isDev = import.meta.env.DEV;
const entry = Astro.locals.starlightRoute?.entry;
const filePath = entry?.filePath ?? "";
const isMarkdown = filePath.endsWith(".md") || filePath.endsWith(".mdx");
// starlight-blog's tag, author and page listings claim paths under the blog
// folder too, but only a real post has a date.
const isPost = filePath.startsWith("src/content/docs/blog/") && entry?.data.date !== undefined;
const canEdit = isMarkdown && (isDev || isPost);
// The production endpoint takes paths from the repository root.
const editPath = isDev ? filePath : `docs/website/${filePath}`;
---

{
  canEdit && (
    <div class="dev-editor-root" data-file-path={editPath} data-pagefind-ignore="all">
      <button class="dev-editor-trigger" type="button" title="Edit this page" hidden={!isDev}>
        ✎ Edit
      </button>
      <div class="dev-editor-backdrop" hidden>
        <div class="dev-editor-panel">
          <div class="dev-editor-header">
            <span class="dev-editor-title">{editPath}</span>
            <div class="dev-editor-actions">
              <button class="dev-editor-save" type="button">
                Save (⌘S)
              </button>
              {!isDev && (
                <button class="dev-editor-lock" type="button" title="Forget the edit token on this device">
                  Lock
                </button>
              )}
              <button class="dev-editor-cancel" type="button">
                Close (Esc)
              </button>
            </div>
          </div>
          <div class="dev-editor-host" />
          <div class="dev-editor-status" />
        </div>
      </div>
      <style is:inline>
        .dev-editor-trigger {
          position: fixed;
          bottom: 1rem;
          right: 1rem;
          z-index: 2147483646;
          background: var(--sl-color-accent, #9d7cd8);
          color: #fff;
          border: none;
          border-radius: 6px;
          padding: 0.5rem 0.85rem;
          font-size: 0.875rem;
          font-weight: 600;
          cursor: pointer;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
          font-family: inherit;
        }
        .dev-editor-trigger:hover {
          filter: brightness(1.1);
        }
        .dev-editor-trigger[hidden] {
          display: none;
        }
        .dev-editor-backdrop {
          position: fixed;
          inset: 0;
          background: rgba(0, 0, 0, 0.65);
          z-index: 2147483647;
          display: grid;
          place-items: center;
          padding: 2rem;
        }
        .dev-editor-backdrop[hidden] {
          display: none;
        }
        .dev-editor-panel {
          background: var(--sl-color-bg, #17181c);
          color: var(--sl-color-white, #fff);
          width: min(100%, 1100px);
          height: min(92vh, 900px);
          border-radius: 8px;
          display: flex;
          flex-direction: column;
          border: 1px solid var(--sl-color-gray-5, #444);
          overflow: hidden;
        }
        .dev-editor-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 0.6rem 0.85rem;
          border-bottom: 1px solid var(--sl-color-gray-5, #444);
          font-family: var(--__sl-font-mono, ui-monospace, monospace);
          font-size: 0.8rem;
          gap: 1rem;
        }
        .dev-editor-title {
          opacity: 0.75;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          min-width: 0;
        }
        .dev-editor-actions {
          display: flex;
          gap: 0.5rem;
          flex-shrink: 0;
        }
        .dev-editor-actions button {
          background: var(--sl-color-gray-6, #2b2d33);
          color: var(--sl-color-white, #fff);
          border: 1px solid var(--sl-color-gray-5, #444);
          border-radius: 4px;
          padding: 0.35rem 0.7rem;
          cursor: pointer;
          font-size: 0.8rem;
          font-family: inherit;
        }
        .dev-editor-save {
          background: var(--sl-color-accent, #9d7cd8) !important;
          border-color: transparent !important;
        }
        .dev-editor-host {
          flex: 1;
          min-height: 0;
          overflow: hidden;
          background: #282a36;
        }
        .dev-editor-host .cm-editor {
          height: 100%;
          font-size: 14px;
        }
        .dev-editor-host .cm-scroller {
          font-family: var(--__sl-font-mono, ui-monospace, monospace);
        }
        .dev-editor-status {
          padding: 0.4rem 0.85rem;
          border-top: 1px solid var(--sl-color-gray-5, #444);
          font-size: 0.75rem;
          min-height: 1.6em;
          opacity: 0.75;
          font-family: var(--__sl-font-mono, ui-monospace, monospace);
        }
        .dev-editor-status a {
          color: inherit;
        }
        .dev-editor-status button {
          background: var(--sl-color-gray-6, #2b2d33);
          color: inherit;
          border: 1px solid var(--sl-color-gray-5, #444);
          border-radius: 4px;
          padding: 0.1rem 0.5rem;
          cursor: pointer;
          font: inherit;
        }
      </style>
    </div>
  )
}


<script>
  import type { EditorView } from "./editor/codemirror";

  const TOKEN_KEY = "fragmentcolor:edit-token";

  function readToken(): string | null {
    try {
      return localStorage.getItem(TOKEN_KEY);
    } catch {
      return null;
    }
  }

  function storeToken(token: string | null) {
    try {
      if (token) localStorage.setItem(TOKEN_KEY, token);
      else localStorage.removeItem(TOKEN_KEY);
    } catch {}
  }

  // The token also lives in memory, so a page without storage can still edit.
  let token = readToken();
  const url = new URL(location.href);
  const mode = url.searchParams.get("edit");
  if (mode === "unlock" || mode === "lock") {
    url.searchParams.delete("edit");
    history.replaceState(history.state, "", url);
    token = mode === "unlock" ? prompt("Edit token")?.trim() || token : null;
    storeToken(token);
  }

  const root = document.querySelector<HTMLDivElement>(".dev-editor-root");
  if (root && (import.meta.env.DEV || token)) {
    // Portal to <body> to escape any ancestor stacking contexts
    // (Starlight's `.main-pane` uses `isolation: isolate`).
    if (root.parentElement !== document.body) {
      document.body.appendChild(root);
    }

    const filePath = root.dataset.filePath || "";
    const trigger = root.querySelector<HTMLButtonElement>(".dev-editor-trigger")!;
    const backdrop = root.querySelector<HTMLDivElement>(".dev-editor-backdrop")!;
    const host = root.querySelector<HTMLDivElement>(".dev-editor-host")!;
    const status = root.querySelector<HTMLDivElement>(".dev-editor-status")!;
    const saveBtn = root.querySelector<HTMLButtonElement>(".dev-editor-save")!;
    const cancelBtn = root.querySelector<HTMLButtonElement>(".dev-editor-cancel")!;
    const lockBtn = root.querySelector<HTMLButtonElement>(".dev-editor-lock");

    let view: EditorView | null = null;
    // The text as last loaded or saved, which tells unsaved edits apart.
    let loaded = "";
    // Blob sha of `loaded`. GitHub refuses a save once the post changed,
    // so it only ever changes together with the text it belongs to.
    let sha = "";

    trigger.hidden = false;

    function say(message: string, extra?: Node) {
      status.textContent = message;
      if (extra) status.append(extra);
    }

    function link(url: string): HTMLAnchorElement {
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.target = "_blank";
      anchor.rel = "noopener";
      anchor.textContent = url;
      return anchor;
    }

    function action(label: string, run: () => void): HTMLButtonElement {
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = label;
      button.addEventListener("click", run);
      return button;
    }

    function headers(): Record<string, string> {
      return { authorization: `Bearer ${token}`, "content-type": "application/json" };
    }

    async function check(res: Response): Promise<Response> {
      if (res.status === 401) {
        throw new Error("the edit token was rejected.");
      }
      if (!res.ok) throw new Error(await res.text());
      return res;
    }

    async function load(): Promise<{ doc: string; sha: string; note: string }> {
      const query = `?path=${encodeURIComponent(filePath)}`;
      if (import.meta.env.DEV) {
        const res = await check(await fetch(`/api/dev/edit${query}`));
        return { doc: await res.text(), sha: "", note: "" };
      }
      const res = await check(await fetch(`/api/edit${query}`, { headers: headers() }));
      return {
        doc: await res.text(),
        sha: res.headers.get("x-edit-sha") ?? "",
        note: `Loaded from ${res.headers.get("x-edit-ref")}. Saving commits to content/edits.`,
      };
    }

    async function open() {
      backdrop.hidden = false;
      // Reopening keeps unsaved text. Only an explicit reload replaces it.
      if (view && view.state.doc.toString() !== loaded) {
        view.focus();
        return;
      }
      await reload();
    }

    async function reload() {
      say("Loading…");
      try {
        const [latest, { mountEditor }] = await Promise.all([
          load(),
          import("./editor/codemirror"),
        ]);
        view?.destroy();
        view = mountEditor(host, latest.doc);
        loaded = latest.doc;
        sha = latest.sha;
        say(latest.note);
      } catch (e) {
        say(`Load failed: ${e}`);
      }
    }

    function close() {
      backdrop.hidden = true;
    }

    async function save() {
      if (!view) return;
      say("Saving…");
      const content = view.state.doc.toString();
      try {
        if (import.meta.env.DEV) {
          await check(
            await fetch("/api/dev/edit", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ path: filePath, content }),
            }),
          );
          say("Saved. Reloading…");
          setTimeout(() => location.reload(), 400);
          return;
        }
        const res = await fetch("/api/edit", {
          method: "POST",
          headers: headers(),
          body: JSON.stringify({ path: filePath, content, sha }),
        });
        // A conflict keeps both the text and its old sha, so saving again
        // can't overwrite the newer post until someone loads it on purpose.
        if (res.status === 409) {
          const replace = action("Replace it with the latest version", reload);
          say(`${await res.text()} Your text is still here. `, replace);
          return;
        }
        const result = (await (await check(res)).json()) as { pr: string; sha: string };
        loaded = content;
        sha = result.sha;
        say("Committed to content/edits. Pull request: ", link(result.pr));
      } catch (e) {
        say(`Save failed: ${e}`);
      }
    }

    function lock() {
      token = null;
      storeToken(null);
      close();
      trigger.hidden = true;
    }

    trigger.addEventListener("click", open);
    cancelBtn.addEventListener("click", close);
    saveBtn.addEventListener("click", save);
    lockBtn?.addEventListener("click", lock);
    backdrop.addEventListener("click", (e) => {
      if (e.target === backdrop) close();
    });

    document.addEventListener("keydown", (e) => {
      if (backdrop.hidden) return;
      // An Escape that CodeMirror used, to close search or completions, stays there.
      if (e.key === "Escape" && !e.defaultPrevented) {
        e.preventDefault();
        close();
      } else if ((e.metaKey || e.ctrlKey) && e.key === "s") {
        e.preventDefault();
        save();
      }
    });
  }
</script>
