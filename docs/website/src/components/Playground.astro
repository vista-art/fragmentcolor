<script>
  import { DEMOS } from "../playground/demos/index.js";
  import { wireDivider } from "../playground/divider.js";
  import { wireMenu } from "../playground/menu.js";

  if (!customElements.get("fc-playground")) {
    class PlaygroundElement extends HTMLElement {
      #playground: { start(id?: string): Promise<void>; select(id: string): void; destroy(): void } | undefined;
      #menu: { show(id: string): void; unwire(): void } | undefined;
      #unwire: (() => void) | undefined;

      connectedCallback() {
        // The divider and the demo menu work before the runtime loads, and when it fails to.
        this.#unwire = wireDivider(this);
        const ids = (this.dataset.demos ?? "").split(",");
        const demos = ids.flatMap((id) => DEMOS.filter((d) => d.id === id));
        let hash = location.hash.slice(1);
        try {
          hash = decodeURIComponent(hash);
        } catch {
          // a malformed escape just matches no demo
        }
        let first = this.dataset.mode === "full" && ids.includes(hash) ? hash : this.dataset.demo;
        // A demo picked before the playground starts is the one it starts on.
        this.#menu = wireMenu(this, demos, (id) => {
          if (this.dataset.mode === "full") history.replaceState(null, "", `#${id}`);
          first = id;
          this.#playground?.select(id);
        });
        if (first) this.#menu.show(first);

        import("../playground/host.js")
          .then(({ Playground }) => {
            const playground = new Playground(this, demos);
            this.#playground = playground;
            return playground.start(first);
          })
          .catch((err) => {
            console.error("[playground] start failed", err);
            const fallback = this.querySelector<HTMLElement>(".fcp-fallback");
            if (fallback) fallback.hidden = false;
            const status = this.querySelector(".fcp-status");
            if (status) status.textContent = "";
          });
      }

      disconnectedCallback() {
        this.#unwire?.();
        this.#menu?.unwire();
        this.#playground?.destroy();
      }
    }
    customElements.define("fc-playground", PlaygroundElement);
  }
</script>
